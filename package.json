{
  "name": "aurex-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev apps/web --hostname 0.0.0.0",
    "build": "next build apps/web",
    "start": "next start apps/web --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/test-bootstrap.mjs && playwright test",
    "db:start": "node scripts/local-start.mjs",
    "lint": "eslint .",
    "db:migrate": "node scripts/db-prepare.mjs",
    "db:stop": "docker compose --env-file infra/local/.env -f infra/local/compose.yml stop",
    "format": "prettier --write apps packages tests scripts docs README.md *.ts *.mjs *.json .github infra --ignore-unknown",
    "format:check": "prettier --check apps packages tests scripts docs README.md *.ts *.mjs *.json .github infra --ignore-unknown"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "decimal.js": "^10.6.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "otplib": "^13.5.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
